# LINE Developers → 対象のMessaging APIチャネル → 「Messaging API設定」タブ
#   チャネルアクセストークン（長期）を発行して貼る
LINE_CHANNEL_ACCESS_TOKEN=

# 「チャネル基本設定」タブのチャネルシークレット
# webhookサーバーの署名検証に使う（リッチメニューを出すだけなら空でよい）
LINE_CHANNEL_SECRET=

# 「保険のお手続きナビ」の公開先。リッチメニューのリンク先になる。
# 既定値がこのURLなので、同じ場所に出すなら設定しなくてよい
# SITE_BASE_URL=https://takuya1128iuy-pixel.github.io/ai-secretary-pages/hoken-navi
