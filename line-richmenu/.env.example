# LINE Developers → 対象のMessaging APIチャネル → 「Messaging API設定」タブ
#   チャネルアクセストークン（長期）を発行して貼る
LINE_CHANNEL_ACCESS_TOKEN=

# 「チャネル基本設定」タブのチャネルシークレット
# webhookサーバーの署名検証に使う（リッチメニューを出すだけなら空でよい）
LINE_CHANNEL_SECRET=

# 「保険のお手続きナビ」を公開した場所。リッチメニューのリンク先になる
# 末尾のスラッシュは付けても付けなくてもよい
SITE_BASE_URL=https://example.com/hoken-navi
